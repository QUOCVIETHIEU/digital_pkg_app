{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "syrup mixing desktop",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "syrup mixing (Web)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome",
        "--web-port",
        "8888",
        "--web-browser-flag",
        "--disable-web-security",
        "--web-header=Cross-Origin-Opener-Policy=same-origin",
        "--web-header=Cross-Origin-Embedder-Policy=require-corp",
        "--dart-define=FLUTTER_BASE_HREF=/syrup-mixing/"
      ]
    },
    {
      "name": "syrup mixing (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "syrup mixing (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
